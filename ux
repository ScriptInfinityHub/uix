function Window:Notify(config)
    config = config or {}
    local duration = tonumber(config.Duration) or 3

    local holder = self.Gui:FindFirstChild("Notifications")
    if not holder then
        holder = New("Frame", {
            Name = "Notifications",
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -18, 1, -18),
            Size = UDim2.fromOffset(280, 300),
            BackgroundTransparency = 1,
            ZIndex = 200,
        })
        holder.Parent = self.Gui
        local layout = New("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            Padding = UDim.new(0, 8),
        })
        layout.Parent = holder
    end

    local note = New("Frame", {
        Size = UDim2.fromOffset(270, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = BG2,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 201,
    })
    note.Parent = holder
    Corner(note, 7)
    Stroke(note, STROKE, 1)
    Padding(note, 12, 12, 10, 10)

    local nlayout = New("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
    nlayout.Parent = note

    local title = New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamSemibold,
        Text = config.Title or "Notification",
        TextSize = 11,
        TextColor3 = TEXT,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 202,
    })
    title.Parent = note

    local body = New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = config.Text or "",
        TextSize = 10,
        TextColor3 = MUTED,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 202,
    })
    body.Parent = note

    local accent = New("Frame", {
        Position = UDim2.fromOffset(-12, -10),
        Size = UDim2.fromOffset(3, 999),
        BackgroundColor3 = self.Accent,
        BorderSizePixel = 0,
        ZIndex = 203,
    })
    accent.Parent = note
    self:_registerAccent(accent, "BackgroundColor3")

    note.BackgroundTransparency = 1
    title.TextTransparency = 1
    body.TextTransparency = 1
    Tween(note, {BackgroundTransparency = 0}, 0.18)
    Tween(title, {TextTransparency = 0}, 0.18)
    Tween(body, {TextTransparency = 0}, 0.18)

    task.delay(duration, function()
        if not note.Parent then return end
        Tween(note, {BackgroundTransparency = 1}, 0.18)
        Tween(title, {TextTransparency = 1}, 0.18)
        Tween(body, {TextTransparency = 1}, 0.18)
        task.wait(0.2)
        if note then note:Destroy() end
    end)
end

return Library
